{
  "name": "kanji_backend",
  "version": "2.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "generate:kanji-full": "node scripts/generate_kanji_full_from_svg.js --svg-dir ./kanji_svg --all --out-json ./kanji_full.json",
    "check:kanji-full": "node scripts/check_kanji_full_exists.js",
    "pretest:descriptor-quality": "npm run check:kanji-full",
    "test:descriptor-quality": "node scripts/run_descriptor_batch_quality_check.js --kanji-list 田,山,四,口,日,目,回,用,木,本,未,末,七,六 --file ./training_data.jsonl --descriptor-file ./data/kanji_descriptors.json --dataset ./kanji_full.json --out-dir ./candidate_reports_training --continue-on-error",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:regression": "node --test tests/regression/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "start": "node server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mongodb": "^7.4.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1"
  }
}
